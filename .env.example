# Copy to .env.local for development. In Vercel, set the same names under
# Project → Settings → Environment Variables.
# Leave the Supabase values empty to run locally in preview mode (sample data, no sign-in).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: steers Google's account picker to one domain. Leave empty, since the team
# signs in from several domains (suqmedia.com, nickfisher.dev, soulmanmarketing.com).
NEXT_PUBLIC_PULSE_EMAIL_DOMAIN=

# Used by `npm run seed` to create invites. Comma-separated.
PULSE_ADMIN_EMAILS=nick@nickfisher.dev,info@suqmedia.com
PULSE_VIEWER_EMAILS=eric@soulmanmarketing.com

# AI layer (phase 5). Model name lives here so it can change without a deploy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Protects /api/cron/sync. Any long random string; set the same value in Vercel.
CRON_SECRET=

# Google OAuth client (the same one Supabase uses for sign-in). Needed for Connect Google and the nightly Google sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
